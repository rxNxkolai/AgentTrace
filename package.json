{
  "name": "@rnxkolai/agenttrace",
  "version": "0.5.0",
  "description": "The open-source flight recorder for AI agents. Records what a Claude Code session did and turns it into a readable receipt.",
  "license": "MIT",
  "type": "module",
  "author": "rxNxkolai (https://github.com/rxNxkolai)",
  "homepage": "https://github.com/rxNxkolai/AgentTrace#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rxNxkolai/AgentTrace.git"
  },
  "bugs": {
    "url": "https://github.com/rxNxkolai/AgentTrace/issues"
  },
  "bin": {
    "agenttrace": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets/hook.cjs",
    "assets/dashboard.html",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "agent",
    "claude-code",
    "observability",
    "trace",
    "flight-recorder",
    "receipt"
  ],
  "dependencies": {
    "commander": "^12.1.0",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
